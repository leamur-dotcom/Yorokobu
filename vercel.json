{
  "version": 2,
  "builds": [
    { "src": "web/package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/antigua", "dest": "/public/index.html" },
    { "src": "/antigua/(.*)", "dest": "/public/$1" },
    { "src": "/(.*)", "dest": "/web/dist/$1" }
  ]
}
